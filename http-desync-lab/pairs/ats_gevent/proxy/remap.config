# Apache Traffic Server 9.2.0 Remap Configuration
# Routes traffic from proxy to backend server

# Access Control Rules:
# /path1 -> ALLOW (forward to backend)
# /path2 -> DENY (return 403 Forbidden)

# Deny direct access to /path2 (internal/admin path)
map http://localhost/path2 http://localhost @action=deny @status=403

# Allow access to /path1 and forward to backend
map http://localhost/path1 http://backend:5000/path1

# Map all other traffic from / to backend:5000
map / http://backend:5000/
