# Apache Traffic Server 9.2.0 Configuration
# This configuration intentionally preserves the Trailer Section bug for demonstration purposes

# Server ports - listen on port 80 internally
CONFIG proxy.config.http.server_ports STRING 80

# Enable reverse proxy mode
CONFIG proxy.config.reverse_proxy.enabled INT 1

# Require remap rules for all requests
CONFIG proxy.config.url_remap.remap_required INT 1

# Access control rules
# /path1 -> ALLOW (forward to backend)
# /path2 -> DENY (return 403 Forbidden)
CONFIG proxy.config.http.parent_proxy.file STRING parent.config

# Disable caching to ensure all requests are forwarded
CONFIG proxy.config.http.cache.http INT 0

# Connection settings
CONFIG proxy.config.http.keep_alive_enabled_in INT 1
CONFIG proxy.config.http.keep_alive_enabled_out INT 1

# Logging
CONFIG proxy.config.diags.debug.enabled INT 1
CONFIG proxy.config.diags.debug.tags STRING http
