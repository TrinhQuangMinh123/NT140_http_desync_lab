# Response-side harness (paper §4.3.2 mode 2). Must come BEFORE the
# catch-all `map /` rules so prefix matching picks /resp-test/ first.
map /resp-test/ http://host.docker.internal:9501/
map http://127.0.0.1:8889/resp-test/ http://host.docker.internal:9501/
map http://localhost:8889/resp-test/ http://host.docker.internal:9501/

map / http://backend:9002/
map http://127.0.0.1:8889/ http://backend:9002/
map http://localhost:8889/ http://backend:9002/
